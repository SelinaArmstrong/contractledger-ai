# Server-side only. Never prefix this variable with NEXT_PUBLIC_.
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key

# Optional canonical URL used for social preview metadata.
SITE_URL=http://localhost:3000

# Optional comma-separated Sites user IDs allowed to reset hosted demo data.
# Localhost remains resettable for the interview workflow.
DEMO_ADMIN_USER_IDS=

# Optional temporary single-user login for a public/custom-domain demo.
# Use a strong password and a random secret of at least 32 characters.
DEMO_AUTH_USERNAME=
DEMO_AUTH_PASSWORD=
DEMO_AUTH_DISPLAY_NAME=Selina Armstrong
DEMO_AUTH_SESSION_SECRET=

# Server-side only. Never prefix this variable with NEXT_PUBLIC_.
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key

# Canonical URL used for social preview metadata. Set this to the deployed
# origin in hosted environments, e.g. https://contractledger.selinaq.com
SITE_URL=http://localhost:3000

# Optional comma-separated Sites user IDs allowed to reset hosted demo data.
# Localhost remains resettable for the interview workflow.
DEMO_ADMIN_USER_IDS=

# Optional JSON object mapping authenticated Sites user IDs or email addresses
# to one of the seven workspace roles. Unmapped hosted users are read-only auditors.
# Example: {"user_123":"contract_administrator","legal@example.com":"legal_reviewer"}
WORKSPACE_ROLE_ASSIGNMENTS=

# Optional temporary single-user login for a public/custom-domain demo.
# Use a strong password and a random secret of at least 32 characters.
DEMO_AUTH_USERNAME=
DEMO_AUTH_PASSWORD=
DEMO_AUTH_DISPLAY_NAME=Selina Armstrong
DEMO_AUTH_SESSION_SECRET=

# Optional public read-only browsing for the hosted portfolio demo. When "true",
# visitors without an account get the read_only_auditor role: every register is
# readable, but uploads, decisions, imports, AI calls and reset are refused.
DEMO_GUEST_ACCESS=false

# Server-side only. Never prefix any of these with NEXT_PUBLIC_.

# Required for AI features: contract/supplier analysis, Assistant, Insights,
# and validation runs. The seeded demo is fully browsable without it.
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key

# Canonical URL used for social preview metadata. Set this to the deployed
# origin in hosted environments, e.g. https://contractledger.selinaq.com
SITE_URL=http://localhost:3000

# Hosting project identifier, stamped into the built bundle at deploy time.
# Deliberately absent from `.openai/hosting.json` so a public repository does
# not carry one account's project id. Only the person deploying needs it.
OPENAI_PROJECT_ID=

# --- Access -----------------------------------------------------------------

# When "true", an unauthenticated request arriving on localhost / 127.0.0.1 is
# treated as the maintainer, so `npm run dev` needs no credentials. A request's
# hostname comes from the client-supplied Host header, so this must never be
# set on a hosted deployment: anything able to reach it with `Host: localhost`
# would get the administrator role for free.
ALLOW_LOCAL_MAINTAINER=true

# Set to "true" only when a proxy in front of this app overwrites
# X-Forwarded-For. Cloudflare's own cf-connecting-ip is always trusted and
# needs no setting. Left unset, a forgeable X-Forwarded-For is ignored, so the
# login rate limit and per-visitor AI budget cannot be walked around by
# rotating a header.
TRUST_PROXY_ADDRESS_HEADER=false

# When "true", visitors without an account get the read_only_auditor role:
# every register is readable, but uploads, decisions, imports, AI calls and
# reset are refused server-side.
DEMO_GUEST_ACCESS=false

# Reviewer account. There is no default: credentials come only from the host's
# secret store, so a copy of this repository grants no access and an
# unconfigured deployment has no sign-in rather than a guessable one.
DEMO_AUTH_USERNAME=
DEMO_AUTH_PASSWORD=
DEMO_AUTH_DISPLAY_NAME=Reviewer

# Role granted to the demo account. Defaults to demo_operator: every
# contract-operations workflow including approvals, but not reset_workspace.
# Any role from the policy is accepted, which is also how you demonstrate the
# product as a legal_reviewer or read_only_auditor.
DEMO_AUTH_ROLE=demo_operator

# Optional maintainer account with the administrator role, which is the only
# way to reset the hosted workspace.
ADMIN_AUTH_USERNAME=
ADMIN_AUTH_PASSWORD=
ADMIN_AUTH_DISPLAY_NAME=

# Random string of at least 32 characters used to sign session cookies.
# REQUIRED for any sign-in at all: without it every account is disabled, because
# a known signing key would let anyone mint a session without a password.
# Generate one with:  openssl rand -base64 48
WORKSPACE_SESSION_SECRET=

# --- AI cost controls -------------------------------------------------------

# Shared ceiling on model-backed calls for the whole deployment, per UTC day,
# measured in weighted units. One analysis costs 1 unit, Management Insights 2,
# and a 15-document validation run 15. Reaching the ceiling disables AI calls
# only; every saved record stays browsable.
AI_DAILY_UNIT_BUDGET=250

# Ceiling for a single visitor per hour, so one person cannot drain the shared
# daily pool. Visitors are counted by a hashed client address.
AI_VISITOR_HOURLY_UNIT_BUDGET=40
